---
import { Code } from '@astrojs/starlight/components';
---

<div data-quick-install="unix">
  <Code code="curl -fsSL https://github.com/mealet/zeen/releases/latest/download/install.sh | sh" lang="bash" />
</div>

<div data-quick-install="windows" hidden>
  <Code
    code="irm https://github.com/mealet/zeen/releases/latest/download/install.ps1 | iex"
    lang="bash"
  />
</div>

<script is:inline>
  if (navigator.userAgent.includes('Windows')) {
    document.querySelectorAll('[data-quick-install]').forEach(function (el) {
      el.hidden = el.getAttribute('data-quick-install') !== 'windows';
    });
  }
</script>
